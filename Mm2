local function GetMurdererTarget()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and GetPlayerRole(plr) == "Murderer" then
            if plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                local targetPart = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    return targetPart
                end
            end
        end
    end
    return nil
end

-- Silent Aim Hook
local Meta = getrawmetatable(game)
local OldNamecall = Meta.__namecall
setreadonly(Meta, false)

Meta.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if _G.SilentAim and method == "FireServer" and tostring(self) == "ShootGun" then
        local targetPart = GetMurdererTarget()
        if targetPart then
            args[2] = targetPart.Position
            return OldNamecall(self, unpack(args))
        end
    end

    return OldNamecall(self, ...)
end)
setreadonly(Meta, true)

