-- Helper Function: Check Player Roles
local function GetPlayerRole(plr)
    if not plr or not plr.Character then return "Innocent" end
    if plr.Backpack:FindFirstChild("Knife") or plr.Character:FindFirstChild("Knife") then
        return "Murderer"
    elseif plr.Backpack:FindFirstChild("Gun") or plr.Character:FindFirstChild("Gun") then
        return "Sheriff"
    end
    return "Innocent"
end

-- ฟังก์ชันตรวจสอบว่าเกมเริ่มหรือยัง
local function CheckGameStarted()
    local coinContainer = Workspace:FindFirstChild("Normal") or Workspace:FindFirstChild("Container")
    local hasCoins = coinContainer and coinContainer:FindFirstChild("CoinContainer") and #coinContainer.CoinContainer:GetChildren() > 0
    
    local hasRoleInGame = false
    for _, plr in pairs(Players:GetPlayers()) do
        if GetPlayerRole(plr) ~= "Innocent" then
            hasRoleInGame = true
            break
        end
    end

    return hasCoins or hasRoleInGame
end

