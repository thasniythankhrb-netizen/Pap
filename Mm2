local function FlingPlayer(targetPlr)
    if not targetPlr or not targetPlr.Character or not targetPlr.Character:FindFirstChild("HumanoidRootPart") then
        Rayfield:Notify({Title = "Error", Content = "ไม่พบตัวละครเป้าหมาย!", Duration = 3})
        return
    end

    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local TargetHRP = targetPlr.Character.HumanoidRootPart
    local oldCFrame = myHRP.CFrame

    local bV = Instance.new("BodyVelocity")
    bV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bV.Velocity = Vector3.new(99999, 99999, 99999)
    bV.Parent = myHRP

    local connection
    local startTime = tick()

    connection = RunService.Heartbeat:Connect(function()
        if tick() - startTime > 1.5 or not TargetHRP or not TargetHRP.Parent then
            connection:Disconnect()
            bV:Destroy()
            myHRP.Velocity = Vector3.new(0, 0, 0)
            myHRP.CFrame = oldCFrame
            return
        end
        myHRP.CFrame = TargetHRP.CFrame * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))
        myHRP.Velocity = Vector3.new(99999, 99999, 99999)
    end)
end

